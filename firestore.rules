rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasAccess(userId) {
      return exists(/databases/$(database)/documents/access/$(userId));
    }

    function isActive(userId) {
      return hasAccess(userId)
        && get(/databases/$(database)/documents/access/$(userId)).data.status == 'active';
    }

    function isLinkedPartner(userId) {
      return signedIn()
        && isActive(request.auth.uid)
        && isActive(userId)
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.mode == 'couple'
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.partnerEnabled == true
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.partnerUid == userId
        && get(/databases/$(database)/documents/access/$(userId)).data.partnerEnabled == true
        && get(/databases/$(database)/documents/access/$(userId)).data.partnerUid == request.auth.uid;
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /access/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isAdmin()
        || (isOwner(userId) && isActive(userId))
        || isLinkedPartner(userId);
      allow list: if isAdmin();

      allow create: if isAdmin()
        || (
          isOwner(userId)
          && isActive(userId)
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.spouseUid == ''
        );

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && isActive(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'spouseUid', 'spouseName'])
        );

      allow delete: if isAdmin();
    }

    match /audit/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

